# Copy to .env and generate local keys with npm run setup:local.
# Demo contains labeled sample data and two test accounts. Never use demo in a public production deployment.
DEMO_MODE=true
APP_URL=http://localhost:3000
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=postgresql://move:move_local_only@localhost:5432/the_move?schema=public
REDIS_URL=redis://localhost:6379
# Required only for non-demo seeding. Minimum 12 characters; enter secure unique passwords locally.
OPERATOR_1_PASSWORD=
OPERATOR_2_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional server-only alternative to OAuth, must be legitimately authorized.
CANVA_ACCESS_TOKEN=
# Confirm brand-template IDs after dataset inspection. The known reference design IDs are not brand-template IDs.
CANVA_BRAND_TEMPLATE_DAHPXU1IGDI=
CANVA_BRAND_TEMPLATE_DAHXJGy8do8=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
# See docs/INTEGRATIONS.md for permissions, media requirements, unsupported operations and platform review.

# Only trusted administrator-verified public hostnames, exact names comma-separated.
# Needed for source/media access when local DNS is unavailable behind an egress proxy.
SOURCE_PROXY_ALLOWED_HOSTS=github.com
MEDIA_PROXY_ALLOWED_HOSTS=
