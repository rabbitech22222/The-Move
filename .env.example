# 개발은 .env, 실제 실행기는 .env.live를 사용합니다. setup:local은 임의 보안 키를 생성합니다.
# 데모에는 예시 데이터와 공개 시험 계정이 있습니다. 공개 실제 운영에 데모를 사용하지 마세요.
DEMO_MODE=false
# 기본 데스크톱 실행기는 LOCAL_MODE=true로 실제 파일 저장과 로컬 작업 처리기를 사용합니다.
LOCAL_MODE=false
APP_URL=http://localhost:3000
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=postgresql://move:move_local_only@localhost:5432/the_move?schema=public
REDIS_URL=redis://localhost:6379
# 실제 운영 시드에는 서로 다른 12자 이상 비밀번호가 필요합니다. 비밀 값은 내 컴퓨터에서만 입력하세요.
OPERATOR_1_PASSWORD=
OPERATOR_2_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# 정당한 접근 권한이 있는 경우에만 사용하는 서버 전용 OAuth 대체 토큰입니다.
CANVA_ACCESS_TOKEN=
# 실제 원본 필드를 먼저 검사합니다. 필드가 없으면 원본 사본의 승인된 브랜드 템플릿 ID를 지정합니다.
CANVA_BRAND_TEMPLATE_DAHPXU1IGDI=
CANVA_BRAND_TEMPLATE_DAHXJGy8do8=
CANVA_BRAND_TEMPLATE_DAHPcvVkH8k=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
# 권한, 미디어 규격과 외부 앱 검토는 docs/INTEGRATIONS.md를 확인하세요.

# 관리자가 확인한 공개 호스트 이름만 쉼표로 구분해 정확하게 입력합니다.
# 외부 프록시 환경에서 DNS 조회가 불가능한 경우에만 출처·미디어 접근에 사용합니다.
SOURCE_PROXY_ALLOWED_HOSTS=github.com,www.yna.co.kr,rss.donga.com
MEDIA_PROXY_ALLOWED_HOSTS=
